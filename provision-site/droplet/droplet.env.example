# Settings for create-droplet.sh. Copy to droplet.env (gitignored) and edit.
#
#   cp droplet.env.example droplet.env
#
# Nothing in this file is a secret: the DigitalOcean API token is NOT read
# from here. doctl keeps it in the macOS keychain after `doctl auth init`.
# Only SSH *public* keys are referenced, and only by file path.

# Droplet name. Also used as the hostname. create-droplet.sh refuses to run
# if a droplet with this name already exists in the account.
DROPLET_NAME=server04

# Region slug. lon1 = London (closest to the UK pilot sites).
# List: doctl compute region list
DROPLET_REGION=lon1

# Size slug. s-2vcpu-4gb = Basic/Regular 2 vCPU, 4 GB RAM, 80 GB SSD, 4 TB
# transfer, about USD 24/month (Nov 2026). List: doctl compute size list
DROPLET_SIZE=s-2vcpu-4gb

# Image slug for Ubuntu 26.04 LTS. Confirmed from DigitalOcean's release note
# of 1 July 2026 (https://docs.digitalocean.com/notes/2026/ubuntu-26-04/).
# Re-check with: doctl compute image list-distribution --public | grep -i ubuntu
DROPLET_IMAGE=ubuntu-26-04-x64

# SSH key(s) already uploaded to the DigitalOcean account, as a comma-separated
# list of IDs or fingerprints. These go onto the root account via DO's own
# injection and stop DO emailing a root password. Root SSH login is then
# disabled by cloud-init, so they are belt-and-braces only.
# List: doctl compute ssh-key list
DROPLET_SSH_KEYS=

# Public key FILES (space-separated, ~ allowed) whose contents become
# /home/rob/.ssh/authorized_keys on the new server. The script reads them at
# render time and substitutes the placeholder in cloud-init.yaml.
ROB_AUTHORIZED_KEYS_FILES="~/.ssh/ssh_key_02.pub"

# Private key matching one of the files above, used by create-droplet.sh to
# wait for SSH and by verify-droplet.sh. Leave empty to let ssh pick.
ROB_SSH_IDENTITY_FILE="~/.ssh/ssh_key_02"

# Tags (comma-separated). Handy for `doctl compute droplet list --tag-name`.
DROPLET_TAGS=server04,drupal11,ubuntu-26-04,flat-stack

# yes/no. DigitalOcean automated backups (weekly) add 20% to the droplet price.
DROPLET_ENABLE_BACKUPS=no

# Optional: VPC UUID and project ID (doctl vpcs list / doctl projects list).
# Leave empty to use the region's default VPC and the default project.
DROPLET_VPC_UUID=
DROPLET_PROJECT_ID=

# Optional: how long create-droplet.sh waits for SSH and for cloud-init to
# finish, in seconds. First boot installs ~400 packages; 15 minutes is typical.
SSH_WAIT_SECONDS=1200

# Where cloud-init fetches the toolkit scripts from (public repo, no token).
TOOLKIT_REPO_URL=https://github.com/therobyouknow/infrastructure.git
TOOLKIT_REPO_REF=main
